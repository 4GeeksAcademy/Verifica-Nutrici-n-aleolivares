              "name": "sugar_traffic_light",
              "value": "={{ Number($json.sugars_100g || 0) <= 5 ? 'bajo' : (Number($json.sugars_100g || 0) > 22.5 ? 'alto' : 'moderado') }}",
              "type": "string"
            },
            {
              "id": "d430876c-5e56-420d-9157-cb6c8c85d76b",
              "name": "salt_traffic_light",
              "value": "={{ Number($json.salt_100g || 0) <= 0.3 ? 'bajo' : (Number($json.salt_100g || 0) > 1.5 ? 'alto' : 'moderado') }}",
              "type": "string"
            },
            {
              "id": "498af4d8-dee4-4531-8653-08ded618a99b",
              "name": "fat_traffic_light",
              "value": "={{ Number($json.fat_100g || 0) <= 3 ? 'bajo' : (Number($json.fat_100g || 0) > 17.5 ? 'alto' : 'moderado') }}",
              "type": "string"
            },
            {
              "id": "1ccb979b-3c0a-4390-887a-a7fedc93da6f",
              "name": "concern_score",
              "value": "={{ ([Number($json.sugars_100g || 0) > 22.5, Number($json.salt_100g || 0) > 1.5, Number($json.fat_100g || 0) > 17.5].filter(Boolean)).length }}",
              "type": "number"
            },
            {
              "id": "cc0cf750-757b-4dd4-9e05-5d67e3a4c3eb",
              "name": "traffic_light_reading",
              "value": "={{ (([Number($json.sugars_100g || 0) > 22.5, Number($json.salt_100g || 0) > 1.5, Number($json.fat_100g || 0) > 17.5].filter(Boolean)).length >= 2) ? 'no saludable' : ((([Number($json.sugars_100g || 0) > 22.5, Number($json.salt_100g || 0) > 1.5, Number($json.fat_100g || 0) > 17.5].filter(Boolean)).length === 1) ? 'moderado' : 'saludable') }}",
              "type": "string"
            },
            {
              "id": "2cafc0ad-9087-4b2c-9949-2f1b7a65dd9c",
              "name": "nutriscore_reading",
              "value": "={{ ['a','b'].includes(($json.nutriscore_grade || '').toLowerCase()) ? 'saludable' : (['d','e'].includes(($json.nutriscore_grade || '').toLowerCase()) ? 'no saludable' : (($json.nutriscore_grade || '').toLowerCase() === 'c' ? 'moderado' : 'unknown')) }}",
              "type": "string"
            },
            {
              "id": "48309b79-d3f2-461f-b507-7c1e1a71bc83",
              "name": "overall_verdict",
              "value": "={{ ($json.nutriscore_reading === 'unknown' || !$json.nutriscore_reading) ? $json.traffic_light_reading : (['no saludable', 'moderado', 'saludable'].find(v => [$json.traffic_light_reading, $json.nutriscore_reading].includes(v)) || $json.traffic_light_reading) }}",
              "type": "string"
            }
          ]
        },
