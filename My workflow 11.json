        "responseBody": "{{\n  '🏷️ Producto: ' + $('Set - Health Logic').item.json.product_name + '\\n' +\n  ($('Set - Health Logic').item.json.overall_verdict === 'saludable' ? '🟢 Veredicto: Saludable' : ($('Set - Health Logic').item.json.overall_verdict === 'moderado' ? '🟡 Veredicto: Moderado' : '🔴 Veredicto: No saludable')) + '\\n\\n' +\n  '📊 Valores clave (por 100g):\\n' +\n  (($('Set - Health Logic').item.json.sugar_traffic_light === 'alto' || $('Set - Health Logic').item.json.sugar_traffic_light === 'red') ? '🔴' : '🟢') + ' Azúcar: ' + $('Set - Health Logic').item.json.sugars_100g + 'g (' + $('Set - Health Logic').item.json.sugar_traffic_light + ')\\n' +\n  (($('Set - Health Logic').item.json.salt_traffic_light === 'alto' || $('Set - Health Logic').item.json.salt_traffic_light === 'red') ? '🔴' : '🟢') + ' Sal: ' + $('Set - Health Logic').item.json.salt_100g + 'g (' + $('Set - Health Logic').item.json.salt_traffic_light + ')\\n' +\n  (($('Set - Health Logic').item.json.fat_traffic_light === 'alto' || $('Set - Health Logic').item.json.fat_traffic_light === 'red') ? '🔴' : '🟢') + ' Grasa: ' + $('Set - Health Logic').item.json.fat_100g + 'g (' + $('Set - Health Logic').item.json.fat_traffic_light + ')\\n\\n' +\n  '📝 Análisis:\\n' +\n  $json.message.content\n}}",
